# Copy this file to .env.local and fill in real values.

# Base URL of the NestJS backend (Online-Marketplace-Management).
# The Next.js app itself runs on port 3001 so it doesn't clash with it.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Path of the admin login route on the backend. It must accept
# { email, password } and return { accessToken } whose JWT payload has
# role: "admin". Change this if your backend names it differently
# (e.g. /auth/admin/login).
NEXT_PUBLIC_ADMIN_LOGIN_PATH=/admin/auth/login

# Pusher (https://pusher.com) — real-time notifications for all three
# portals (shop, seller hub, admin). Create a free "Channels" app at
# dashboard.pusher.com and copy its keys here.
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# Server-only Pusher credentials, used by app/api/notify/route.ts to trigger events.
PUSHER_APP_ID=your_pusher_app_id
PUSHER_SECRET=your_pusher_secret
